{
  "name": "desktop-companion",
  "version": "0.2.2-beta.1",
  "private": true,
  "description": "鲸伴 Beta — 免费开源的模块化桌面伙伴",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "pack": "electron-builder --dir",
    "mcp": "node integrations/mcp.mjs",
    "renderer:patch": "python scripts/patch_renderer.py",
    "prestart": "node scripts/prepare-icons.cjs && npm run renderer:patch",
    "prepack": "node scripts/prepare-icons.cjs && npm run renderer:patch",
    "postpack": "node scripts/set-app-icon.cjs",
    "setup": "node scripts/setup.cjs",
    "pack:portable": "electron-builder --prepackaged dist/win-unpacked --win portable --publish never"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "rcedit": "5.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "13.0.3",
    "mem0ai": "3.3.1",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "local.desktop-companion",
    "productName": "鲸伴",
    "files": [
      "desktop/**",
      "web/**",
      "lib/**",
      "integrations/**",
      "server.mjs",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "bundled-models/**"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "icon": "web/assets/app.ico"
    },
    "executableName": "jingban",
    "extraFiles": [
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "docs/WINDOWS-START.txt",
        "to": "开始使用.txt"
      },
      {
        "from": "local-asr",
        "to": "local-asr",
        "filter": [
          "*.py",
          "*.ps1",
          "*.txt",
          "*.md"
        ]
      }
    ]
  },
  "author": "澄江子",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "gh-pages": "6.3.0",
    "sharp": "0.35.5",
    "tar": "^7.5.21"
  }
}
